#!/bin/sh
# Runs the Go toolchain in a container, so the host needs only podman.
#   scripts/go test ./...          from anywhere inside the repository
# Host networking, so `scripts/go run ./cmd/klaverjas -addr 127.0.0.1:18200` is
# reachable from the host. Module and build caches live in two podman volumes.
# KJ_GO_NAME names the container; KJ_GO_DETACH=1 runs it in the background
# (scripts/dev-server).
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
case "$PWD/" in
  "$root"/*) rel=${PWD#"$root"} ;;
  *) rel= ;;
esac
# The Containerfile's build image, so that a bump there (Renovate's) applies
# here too.
img=$(sed -n 's/^FROM \([^ ]*golang[^ ]*\) AS build$/\1/p' "$root/Containerfile")
[ -n "$img" ] || { echo "scripts/go: no 'FROM ...golang... AS build' line in $root/Containerfile" >&2; exit 1; }
mode=-i tty=
if [ -n "${KJ_GO_DETACH:-}" ]; then mode=-d; elif [ -t 0 ]; then tty=-t; fi
exec podman run --rm "$mode" ${tty:+"$tty"} --network host \
  -v "$root":/src -v klaverjas-gocache:/go -v klaverjas-gobuild:/root/.cache \
  -e GOFLAGS=-buildvcs=false -e GOTOOLCHAIN=local -e CGO_ENABLED=0 \
  -w "/src$rel" ${KJ_GO_NAME:+--name "$KJ_GO_NAME"} \
  "$img" go "$@"
