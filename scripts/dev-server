#!/bin/sh
# Starts a game's server from source in the background, serving its files,
# web/shared and web/<game>, itself.
#   GAME=klaverjas scripts/dev-server 18200 [extra server flags, e.g. -fast]
#   podman logs -f kj-dev-18200 ; podman stop kj-dev-18200
# GAME is one of the games of deploy/games/*.mk; `make dev` and `make e2e` set it.
set -eu
root=$(cd "$(dirname "$0")/.." && pwd)
games=
for f in "$root"/deploy/games/*.mk; do
  [ -e "$f" ] && games="$games${games:+ }$(basename "$f" .mk)"
done
usage="usage: GAME=<game> dev-server PORT [flags]; the games are $games"
port=${1:?$usage}; shift
game=${GAME:-}
case " $games " in
  *" $game "*) [ -n "$game" ] ;;
  *) false ;;
esac || { echo "dev-server: ${game:+GAME=$game is not a game; }$usage" >&2; exit 2; }
[ -d "$root/cmd/$game" ] || { echo "dev-server: there is no cmd/$game to run" >&2; exit 1; }
podman rm -f "kj-dev-$port" >/dev/null 2>&1 || true
cd "$root"
KJ_GO_NAME="kj-dev-$port" KJ_GO_DETACH=1 scripts/go \
  run "./cmd/$game" -addr "127.0.0.1:$port" -static /src/web "$@" >/dev/null
echo "kj-dev-$port starting $game on http://127.0.0.1:$port/ (compiling; poll /api/health)"
