expect "deploy GAME=klaverjas after a change to its Go code: a new server" 1 "$(built klaverjas)"
for h in $(others klaverjas); do
  deploy_on "$h" "$(running "$h" "$was")"
  expect "deploy GAME=$h after a change to klaverjas's Go code: no new server" 0 "$(built "$h")"
