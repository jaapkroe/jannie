expect "revision of klaverjas after a commit in extra/" 2 "$(grep -c -- "--build-arg GIT_SHA=$head " "$calls")"

# ---- what a deploy restarts -----------------------------------------------------
# The server the pod runs is the one its :current image names (the stub's
# $STUB_REV). A deploy builds a new one only when the server's code changed
# since that commit; else it builds the web image alone, tags the running server
# with the build's tag too, and restarts nginx alone, which keeps the games.
# Commits a line more in each of the files $@ of this repository; head is then
# the new commit.
change() {
  for f in "$@"; do mkdir -p "$(dirname "$repo/$f")"; echo "// $f" >> "$repo/$f"; done
  git add -A
  git commit -q --no-verify -m change
  head=$(git rev-parse HEAD)
}
# The same in extra/, the overlay; xhead is then its new commit.
xchange() {
  for f in "$@"; do mkdir -p "$(dirname "$repo/extra/$f")"; echo "// $f" >> "$repo/extra/$f"; done
  git -C extra add -A
  git -C extra commit -q --no-verify -m change
  xhead=$(git -C extra rev-parse --short=12 HEAD)
}
# The revision of game $1's server built from commit $2 (and the overlay's $3).
running() { case $(folder "$1") in extra/*) echo "$2.${3:-$xhead}" ;; *) echo "$2" ;; esac; }
# Runs make deploy GAME=$1, and the rest of the arguments, with the server of
# revision $2 running.
deploy_on() {
  STUB_REV=$2
  export STUB_REV
  g=$1
  shift 2
  run deploy GAME="$g" "$@"
  unset STUB_REV
}
# 1 when the last make built game $1's server, else 0; the services it restarted.
built() { if grep -q "^podman build --target server .* -t localhost/$1-server:" "$calls"; then echo 1; else echo 0; fi; }
restarted() { sed -n 's/^systemctl --user restart //p' "$calls" | tr '\n' ' ' | sed 's/ $//'; }

deploy_on klaverjas "$head"
expect "deploy, the server's code as it runs: exit status" 0 "$status"
expect "deploy, the server's code as it runs: no server built" 0 "$(built klaverjas)"
expect "deploy, the server's code as it runs: the web image built" 1 "$(grep -c '^podman build --target web ' "$calls" || true)"
t=$(tag klaverjas-web)
expect "deploy, the server's code as it runs: the running server gets the build's tag" 1 \
  "$(hasline "podman tag localhost/klaverjas-server:current localhost/klaverjas-server:$t" "$calls")"
expect "deploy, the server's code as it runs: the web image :current" 1 \
  "$(hasline "podman tag localhost/klaverjas-web:$t localhost/klaverjas-web:current" "$calls")"
expect "deploy, the server's code as it runs: nginx alone restarted" klaverjas-web.service "$(restarted)"
expect "deploy, the server's code as it runs: says so" 1 "$(has 'a new web image only, and the games go on' "$tmp/out")"
expect "deploy, the server's code as it runs: checks that the pod runs its :current images" 1 \
  "$(hasline "$(podcheck klaverjas "$head" "$head")" "$calls")"
expect "deploy, the server's code as it runs: asks nobody about games in progress" 0 \
  "$(grep -c '^curl -fsS ' "$calls" || true)"
# Sites, docs, JS tests, Go tests and their data are none of the server's code.
was=$head
