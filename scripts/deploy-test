for g in $games; do
  run deploy GAME="$g"
  expect "make deploy GAME=$g, exit status" 0 "$status"
  expect "make deploy GAME=$g builds its server" 1 "$(grep -c "^podman build --target server --pull=newer \
--build-arg GIT_SHA=$(rev "$g") --build-arg GAME=$g -t localhost/$g-server:$(rev "$g")-$stamp \.\$" "$calls" || true)"
  expect "make deploy GAME=$g builds its web image, from its folder" 1 "$(grep -c "^podman build --target web --pull=newer \
--build-arg GIT_SHA=$(rev "$g") --build-arg GAME=$g --build-arg GAME_DIR=$(folder "$g") --build-arg SITE=$(val "$g" SITE) \
--build-arg TITLE=$(val "$g" TITLE) --build-arg VERB=$(val "$g" VERB) --build-arg SUPPORT_URL= -t localhost/$g-web:$(rev "$g")-$stamp \.\$" \
    "$calls" || true)"
  expect "make deploy GAME=$g tags only its images" "localhost/$g-server localhost/$g-web " \
    "$(sed -n 's|^podman tag localhost/\([^:]*\):[^ ]* localhost/\1:current$|localhost/\1|p' "$calls" | sort | tr '\n' ' ')"
  expect "make deploy GAME=$g restarts only its pod" "$g-pod.service" \
    "$(sed -n 's/^systemctl --user restart //p' "$calls" | tr '\n' ' ' | sed 's/ $//')"
  expect "make deploy GAME=$g checks its pod" 1 \
    "$(hasline "$(podcheck "$g" "" "")" "$calls")"
  for h in $(others "$g"); do
    expect "make deploy GAME=$g: nothing of $h" 0 "$(words "$h" "$calls")"
  done
done

