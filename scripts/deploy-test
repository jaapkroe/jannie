was=$head
change platform/server/x.go
for g in $games; do
  deploy_on "$g" "$(running "$g" "$was")"
  expect "deploy GAME=$g after a change to the platform's Go code: a new server" 1 "$(built "$g")"
  expect "deploy GAME=$g after a change to the platform's Go code: the pod restarted" "$g-pod.service" "$(restarted)"
  expect "deploy GAME=$g after a change to the platform's Go code: the pod's checks" 1 \
    "$(grep -c "^pod-check $(val "$g" ADDR) " "$calls" || true)"
