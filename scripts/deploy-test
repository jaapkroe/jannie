  klaverjas-web.service "$(restarted)"
run install GAME=klaverjas QUADLET_DIR="$units" SITE=elsewhere.example
expect "make install, a changed setting: the units written" 3 "$(find "$units" -name 'klaverjas*' -newer "$tmp/ref" | wc -l | tr -d ' ')"
deploy_on klaverjas "$head" QUADLET_DIR="$units"
expect "deploy, units written since the pod started: exit status" 0 "$status"
expect "deploy, units written since the pod started: no new server" 0 "$(built klaverjas)"
expect "deploy, units written since the pod started: the server keeps its image" 1 \
  "$(hasline "podman tag localhost/klaverjas-server:current localhost/klaverjas-server:$(tag klaverjas-web)" "$calls")"
expect "deploy, units written since the pod started: the pod restarted" klaverjas-pod.service "$(restarted)"
expect "deploy, units written since the pod started: says why" 1 \
  "$(has 'but the pod restarts: its units changed since it started' "$tmp/out")"
expect "deploy, units written since the pod started: asks about games in progress, before and after the build" 2 \
  "$(grep -c '^curl -fsS ' "$calls" || true)"
STUB_SINCE=
deploy_on klaverjas "$head"
expect "deploy, systemd cannot say when the pod started: the pod restarted" klaverjas-pod.service "$(restarted)"
expect "deploy, systemd cannot say when the pod started: says why" 1 "$(has 'systemd cannot say when it started' "$tmp/out")"
STUB_SINCE=@4102444800
unset STUB_RUNNING
deploy_on klaverjas "$head"
STUB_RUNNING=true
export STUB_RUNNING
expect "deploy, the server not running: the pod restarted" klaverjas-pod.service "$(restarted)"
expect "deploy, the server not running: says why" 1 "$(has 'but the pod restarts: its server is not running' "$tmp/out")"

# ---- games in progress ------------------------------------------------------------
# /api/health's playing: make playing says how many, and a new server waits for none.
busy='{"ok":true,"players":5,"playing":2,"rooms":3,"version":"x"}'
HEALTH=$busy
export HEALTH
run playing GAME=klaverjas
expect "make playing GAME=klaverjas, games in progress: exit status" 2 "$status"
expect "make playing GAME=klaverjas, games in progress: how many" 1 \
  "$(has 'klaverjas: games in progress 2, players connected 5' "$tmp/out")"
run playing
expect "make playing, games in progress: exit status" 2 "$status"
for g in $games; do
  expect "make playing: $g's too, after a game with games in progress" 1 "$(has "$g: games in progress 2" "$tmp/out")"
  expect "make playing: $g's own health" 1 "$(grep -c "^curl .*http://$(val "$g" ADDR)/api/health" "$calls" || true)"
done
deploy_on klaverjas ''
expect "deploy of a new server, games in progress: exit status" 2 "$status"
expect "deploy of a new server, games in progress: says why and what to do" 111 \
  "$(has 'restarting the klaverjas pod ends its games in progress' "$tmp/out")$(has 'make playing GAME=klaverjas' "$tmp/out")$(has 'ALLOW_PLAYING=1' "$tmp/out")"
expect "deploy of a new server, games in progress: builds nothing" 0 "$(has 'podman build' "$calls")"
expect "deploy of a new server, games in progress: restarts nothing" 0 "$(has 'systemctl' "$calls")"
deploy_on klaverjas "$head"
expect "deploy of the web image alone, games in progress: exit status" 0 "$status"
expect "deploy of the web image alone, games in progress: nginx restarted" klaverjas-web.service "$(restarted)"
deploy_on klaverjas '' ALLOW_PLAYING=1
expect "deploy ALLOW_PLAYING=1, games in progress: exit status" 0 "$status"
expect "deploy ALLOW_PLAYING=1, games in progress: a new server" 1 "$(built klaverjas)"
expect "deploy ALLOW_PLAYING=1, games in progress: the pod restarted" klaverjas-pod.service "$(restarted)"
ALLOW_PLAYING=1
export ALLOW_PLAYING
deploy_on klaverjas ''
unset ALLOW_PLAYING
expect "an ALLOW_PLAYING=1 in the environment: deploy refused" 2 "$status"
run deploy GAME=all
expect "deploy GAME=all, games in progress: exit status" 2 "$status"
for h in $(others "$first"); do
  expect "deploy GAME=all, games in progress at $first: nothing of $h" 0 "$(words "$h" "$calls")"
done
# A game that starts during the build: the new server waits, and :current stays.
HEALTH_FROM=2
export HEALTH_FROM
deploy_on klaverjas ''
unset HEALTH_FROM
expect "deploy, a game started during the build: exit status" 2 "$status"
expect "deploy, a game started during the build: built" 1 "$(built klaverjas)"
expect "deploy, a game started during the build: :current stays" 0 "$(grep -c '^podman tag .*:current$' "$calls" || true)"
expect "deploy, a game started during the build: restarts nothing" 0 "$(has 'systemctl' "$calls")"
# A server from before the count: the players connected count instead.
HEALTH='{"ok":true,"players":3,"rooms":3,"version":"x"}'
deploy_on klaverjas ''
expect "deploy, a server without the count and players connected: exit status" 2 "$status"
expect "deploy, a server without the count: says so" 1 "$(has 'does not count its games in progress' "$tmp/out")"
HEALTH='{"ok":true,"players":3,"playing":0,"rooms":3,"version":"x"}'
deploy_on klaverjas ''
expect "deploy of a new server, no game in progress: exit status" 0 "$status"
run playing GAME=klaverjas
expect "make playing GAME=klaverjas, no game in progress: exit status" 0 "$status"
unset HEALTH
# No answer: no game in progress when the server does not run either; when it
# runs (nginx down, say) the games in progress are unknown, and make playing fails.
FAIL_CURL="$(val klaverjas ADDR)/"
export FAIL_CURL
unset STUB_RUNNING
run playing GAME=klaverjas
expect "make playing GAME=klaverjas, no answer and no server: exit status" 0 "$status"
expect "make playing GAME=klaverjas, no answer and no server: says so" 1 \
  "$(has 'no server running, so no game in progress' "$tmp/out")"
STUB_RUNNING=true
export STUB_RUNNING
run playing GAME=klaverjas
expect "make playing GAME=klaverjas, no answer from a running server: exit status" 2 "$status"
expect "make playing GAME=klaverjas, no answer from a running server: says so" 1 \
  "$(has 'does not answer: games in progress unknown' "$tmp/out")"
deploy_on klaverjas ''
expect "deploy of a new server, no answer from a running server: refused" 2 "$status"
unset FAIL_CURL

# A changed file that is tracked.
echo '# changed' >> "$repo/deploy/game.pod.in"
mk image GAME=klaverjas || true
expect "revision of a tree with a changed file" 2 "$(grep -c -- "--build-arg GIT_SHA=$head-dirty " "$calls")"

# ---- a new game is a new folder with its <game>.mk --------------------------------
# presidenten-server, the longest name to come, still fits make status's column.
sed -e 's/^TITLE = .*/TITLE = Presidenten/' -e 's/^VERB = .*/VERB = presidenten/' \
  -e 's/^SITE = .*/SITE = presidenten.example/' -e 's/^ADDR = .*/ADDR = 127.0.0.1:8999/' \
  -e 's/^DEV_PORT = .*/DEV_PORT = 18999/' -e 's/^E2E_PORT = .*/E2E_PORT = 19000/' \
  "$repo/games/klaverjas/klaverjas.mk" > "$tmp/presidenten.mk"
mkdir "$repo/games/presidenten" && mv "$tmp/presidenten.mk" "$repo/games/presidenten/"
run quadlet GAME=presidenten
expect "make quadlet GAME=presidenten, a new game" 1 "$(hasline 'PodName=presidenten' "$tmp/out")"
run status
expect "make status: the new game too" 1 "$(grep -c '^presidenten-server  *revision ' "$tmp/out" || true)"
expect "make status: one column for every name" "" \
  "$(grep -v '^http://' "$tmp/out" | awk 'substr($0, 19, 1) != " " || substr($0, 20, 1) == " "')"
# make test runs every game's JS tests, those of the overlay's game included.
mk -n test || true
expect "make test: the overlay game's JS tests" 1 \
  "$(grep '^node --test ' "$tmp/out" | grep -c ' extra/proef/test/proef\.test\.mjs' || true)"
# A game in both games/ and extra/, or a settings file not named after its folder,
# stops make before it does anything.
mkdir "$repo/extra/presidenten" && cp "$repo/games/presidenten/presidenten.mk" "$repo/extra/presidenten/"
run quadlet
expect "a game in games/ and extra/, exit status" 2 "$status"
expect "a game in games/ and extra/ is named" 1 "$(has 'presidenten is a game twice, in games/presidenten extra/presidenten' "$tmp/out")"
expect "a game in games/ and extra/: nothing run" "" "$(cat "$calls")"
rm -r "$repo/extra/presidenten" "$repo/games/presidenten"
mkdir "$repo/games/pesten" && cp "$repo/extra/proef/proef.mk" "$repo/games/pesten/"
run quadlet
expect "a settings file not named after its folder, exit status" 2 "$status"
expect "a settings file not named after its folder is named" 1 "$(has 'games/pesten/proef.mk: ' "$tmp/out")"
rm -r "$repo/games/pesten"
# Without the overlay: the games of games/ alone, and the image builds make the
# empty extra/ that the Containerfile copies (podman refuses a missing one).
rm -r "$repo/extra"
# A symlink named extra, which the tools cannot follow, is ignored too.
ln -s "$tmp/elsewhere" "$repo/extra"
expect "a symlink named extra ignored by git" 1 "$(holds git check-ignore -q extra)"
rm "$repo/extra"
run quadlet
expect "make quadlet without the overlay, exit status" 0 "$status"
expect "make quadlet without the overlay: no game of it" 0 "$(has 'proef' "$tmp/out")"
for t in image-server image-web; do
  rm -rf "$repo/extra"
  run $t GAME=klaverjas
  expect "make $t without the overlay, exit status" 0 "$status"
  expect "make $t without the overlay makes an empty extra/" 1 "$(holds [ -d "$repo/extra" ])"
  expect "make $t without the overlay builds" 1 "$(grep -c '^podman build ' "$calls" || true)"
done

# ---- scripts/dev-server ------------------------------------------------------------
# The checks above run a stub; this is the real one, in a throwaway tree of its own:
# klaverjas with cmd/klaverjas, pesten and proef with their folders' main packages,
# kwartet with none.
ds=$tmp/ds
mkdir -p "$ds/scripts" "$ds/cmd/klaverjas" "$ds/games/klaverjas" "$ds/games/pesten/cmd/pesten" \
  "$ds/extra/proef/cmd/proef" "$ds/extra/kwartet"
cp "$root/scripts/dev-server" "$ds/scripts/"
printf '#!/bin/sh\necho "$KJ_GO_NAME go $*" >> "%s"\n' "$calls" > "$ds/scripts/go"
chmod +x "$ds/scripts/dev-server" "$ds/scripts/go"
touch "$ds/games/klaverjas/klaverjas.mk" "$ds/games/pesten/pesten.mk" "$ds/extra/proef/proef.mk" \
  "$ds/extra/kwartet/kwartet.mk"
# Runs it with GAME=$1; $calls holds what it ran, $tmp/out what it said, $status
# its exit status.
dev() {
  : > "$calls"
  if GAME=$1 PATH=$tmp/bin:$PATH "$ds/scripts/dev-server" 18200 -fast > "$tmp/out" 2>&1; then
    status=0
  else status=$?; fi
}
for gm in klaverjas:cmd/klaverjas pesten:games/pesten/cmd/pesten proef:extra/proef/cmd/proef; do
  g=${gm%%:*} m=${gm#*:}
  dev "$g"
  expect "dev-server GAME=$g, exit status" 0 "$status"
  expect "dev-server GAME=$g runs $m" "kj-dev-18200 go run ./$m -addr 127.0.0.1:18200 -static /src -fast" \
    "$(grep ' go ' "$calls" || true)"
done
dev kwartet
expect "dev-server, a game without a main package: exit status" 1 "$status"
expect "dev-server, a game without a main package: says so" 1 \
  "$(has 'there is no cmd/kwartet or extra/kwartet/cmd/kwartet' "$tmp/out")"
expect "dev-server, a game without a main package: nothing run" "" "$(cat "$calls")"
mkdir "$ds/cmd/proef"
dev proef
expect "dev-server, a game with two main packages: exit status" 1 "$status"
expect "dev-server, a game with two main packages: names them" 1 \
  "$(has 'two servers for proef, cmd/proef extra/proef/cmd/proef' "$tmp/out")"
expect "dev-server, a game with two main packages: nothing run" "" "$(cat "$calls")"
rmdir "$ds/cmd/proef"
mkdir "$ds/games/proef" && touch "$ds/games/proef/proef.mk"
dev proef
expect "dev-server, a game in games/ and extra/: exit status" 1 "$status"
expect "dev-server, a game in games/ and extra/: names both" 1 \
  "$(has 'proef is a game twice, in games/proef extra/proef' "$tmp/out")"
expect "dev-server, a game in games/ and extra/: nothing run" "" "$(cat "$calls")"
rm -r "$ds/games/proef"
for g in '' bogus ../klaverjas games/klaverjas Klaverjas; do
  dev "$g"
  expect "dev-server GAME='$g', exit status" 2 "$status"
  expect "dev-server GAME='$g': the games named" 1 "$(has 'the games are klaverjas kwartet pesten proef' "$tmp/out")"
  expect "dev-server GAME='$g': nothing run" "" "$(cat "$calls")"
done

# ---- the Containerfile ------------------------------------------------------------
cf=$root/Containerfile
awk '$1 == "FROM" { p = ($NF == "build") } p' "$cf" > "$tmp/build"
awk '$1 == "FROM" { p = ($NF == "server") } p' "$cf" > "$tmp/stage"
expect "Containerfile: one target server" 1 "$(grep -c '^FROM scratch AS server$' "$cf" || true)"
expect "Containerfile: no target of one game" 0 "$(grep -c '^FROM .* AS server-' "$cf" || true)"
for l in 'ARG GAME' 'COPY --from=build /out/${GAME}/ /' 'ENTRYPOINT ["/server"]' 'USER 65532:65532' \
         'CMD ["-addr", "127.0.0.1:8081"]'; do
  expect "server: $l" 1 "$(hasline "$l" "$tmp/stage")"
done
expect "server: labelled with its game" 1 "$(has 'org.opencontainers.image.title="${GAME} server"' "$tmp/stage")"
# Every game's binary, /out/<game>/<game>, named as the unit's HealthCmd runs it,
# and next to it the link /server that the ENTRYPOINT runs.
expect "build: the servers of cmd/" 1 "$(has 'for m in cmd/*; do' "$tmp/build")"
expect "build: each folder's own server, <folder>/cmd/<game>, and no other command" 1 \
  "$(has 'for d in games/* extra/*; do [ ! -d "$d/cmd/${d##*/}" ] || echo "./$d/cmd/${d##*/}"; done' "$tmp/build")"
expect "build: /out/<game>/<game> and the link /out/<game>/server" 1 \
  "$(has 'mv "$b" "/out/$g/$g" && ln -s "$g" "/out/$g/server"' "$tmp/build")"
expect "build: two servers of one name refused" 1 "$(has 'echo "two servers named"' "$tmp/build")"
# An empty GAME would copy every server: the build stage refuses a GAME that
# names none, after the servers are built (so that GAME reruns neither tests nor build).
expect "build: GAME must name a server" 1 "$(has "case \"\$GAME\" in '' | *[!a-z0-9-]*) false;; esac && [ -x \"/out/\$GAME/\$GAME\" ]" "$tmp/build")"
expect "build: GAME after the servers are built" 1 \
  "$(holds [ "$(grep -n -m 1 '^ARG GAME$' "$tmp/build" | cut -d: -f1)" -gt "$(grep -n -m 1 'go build ' "$tmp/build" | cut -d: -f1)" ])"
expect "build: the Go stage copies platform/, games/ and extra/ without their sites" 3 \
  "$(grep -c '^COPY --exclude=\*\*/web .* \(platform\|games\|extra\)/ \(platform\|games\|extra\)/$' "$cf" || true)"
expect "build: no git directory of the overlay" 1 "$(grep -c '^COPY .*--exclude=\*\*/\.git extra/ extra/$' "$cf" || true)"
expect "Containerfile: one target web" 1 "$(grep -c '^FROM .* AS web$' "$cf" || true)"
expect "web: labelled with its game" 1 "$(has 'org.opencontainers.image.title="${GAME} web"' "$cf")"
expect "web-conf: an empty GAME refused before the game's web/ is copied" 1 \
  "$(holds [ "$(grep -n -m 1 'test -n "$GAME"' "$cf" | cut -d: -f1)" -lt \
           "$(grep -n -m 1 'COPY ${GAME_DIR}/web/' "$cf" | cut -d: -f1)" ])"
expect "web-conf: GAME_DIR, the game's folder, checked before it is copied" 1 \
  "$(holds [ "$(grep -n -m 1 'case "$GAME_DIR" in "games/$GAME" | "extra/$GAME")' "$cf" | cut -d: -f1)" -lt \
           "$(grep -n -m 1 'COPY ${GAME_DIR}/web/' "$cf" | cut -d: -f1)" ])"
awk '$1 == "FROM" { p = ($NF == "web-conf") } p' "$cf" > "$tmp/stage"
expect "web-conf: SUPPORT_URL, empty by default" 1 "$(hasline 'ARG SUPPORT_URL=' "$tmp/stage")"
expect "web-conf: fills in @SUPPORT_URL@" 1 "$(has '-e "s|@SUPPORT_URL@|' "$tmp/stage")"
expect "web-conf: no @SUPPORT_URL@ left in index.html" 1 "$(has '-e @SUPPORT_URL@ /tmp/index.html' "$tmp/stage")"
expect "web: nothing copied from the sites but what web-conf checked" \
  "COPY platform/web/ /tmp/shared/ COPY \${GAME_DIR}/web/ /tmp/game/ " \
  "$(grep -E '^COPY (platform/web|\$\{GAME_DIR\}/web|games/|extra/)' "$cf" | grep -v '^COPY --exclude' | tr '\n' ' ')"

# ---- each game's code, pages and simulation, once they are there ----------------
# The games of this checkout, the overlay's included.
for g in $(make -s -C "$root" --no-print-directory --eval='deploy-test-games: ; @echo $(GAMES)' deploy-test-games); do
  dir=
  for d in games extra; do [ ! -f "$root/$d/$g/$g.mk" ] || dir=$d/$g; done
  mains=
  for m in "cmd/$g" "$dir/cmd/$g"; do [ ! -d "$root/$m" ] || mains="$mains${mains:+ }$m"; done
  case $mains in
    '') note "GAME=$g: no cmd/$g or $dir/cmd/$g yet; not checked" ;;
    *' '*) expect "GAME=$g: one server" "one of cmd/$g and $dir/cmd/$g" "$mains" ;;
    *) expect "$mains: a main package" 1 "$(holds grep -qx 'package main' "$root/$mains"/*.go)" ;;
  esac
  site=$root/$dir/web html=$root/$dir/web/index.html
  if [ -f "$html" ]; then
    expect "$dir/web/index.html: the title, TITLE" 1 "$(has "<title>$(val "$g" TITLE)</title>" "$html")"
    for ph in @SITE@ @VERSION@ @SUPPORT_URL@; do
      expect "$dir/web/index.html: $ph, which the build fills in" 1 "$(has "$ph" "$html")"
    done
    expect "$dir/web/index.html: the support link's meta" 1 \
      "$(hasline '<meta name="support" content="@SUPPORT_URL@">' "$html")"
    expect "$dir/web/manifest.webmanifest: the name, TITLE" "\"$(val "$g" TITLE)\"" \
      "$(tr -d '\n' < "$site/manifest.webmanifest" 2>/dev/null \
        | grep -o '"name"[[:space:]]*:[[:space:]]*"[^"]*"' | head -n 1 | sed 's/^[^:]*:[[:space:]]*//')"
    if [ -d "$root/platform/web" ]; then
      expect "no path in both platform/web and $dir/web" "" "$( {
        (cd "$root/platform/web" && find . ! -type d; cd "$site" && find .) | sort | uniq -d
        (cd "$site" && find . ! -type d; cd "$root/platform/web" && find .) | sort | uniq -d
      } | sort -u | tr '\n' ' ')"
    fi
  else
    note "GAME=$g: no $dir/web/index.html yet; not checked"
  fi
  if [ ! -f "$root/$(val "$g" E2E_SIM)" ]; then
    note "GAME=$g: no $(val "$g" E2E_SIM) yet; make e2e GAME=$g cannot run"
  fi
done

if [ "$failed" -gt 0 ]; then
  echo "deploy-test: $failed of $n checks failed" >&2
  exit 1
fi
echo "deploy-test: all $n checks passed"
