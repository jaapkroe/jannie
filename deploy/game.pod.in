# Rendered by `make install` into ~/.config/containers/systemd/@GAME@.pod.
# Change the settings at the top of the Makefile, not the rendered file.
# One network namespace for both containers: nginx (@GAME@-web) on :8080 is
# the only published port; the game server listens on 127.0.0.1:8081 inside.
#   restart: systemctl --user restart @GAME@-pod     logs: make logs
[Unit]
Description=@TITLE@ pod, https://@SITE@/

[Pod]
PodName=@GAME@
# Only the reverse proxy may reach this address.
PublishPort=@ADDR@:8080
# pasta delivers connections from the host's loopback (NPM) from 127.0.0.1
# rather than from the host's LAN address, so nginx can trust exactly that
# hop's X-Real-IP (deploy/nginx.conf).
Network=pasta:--host-lo-to-ns-lo
# The pod stays when both containers die at once, so their Restart= can bring
# them back; podman's default stops it cleanly, and nothing would restart it.
ExitPolicy=continue

[Service]
Restart=on-failure

[Install]
# With lingering enabled for your user, this starts at boot.
WantedBy=default.target
