# Rendered by `make install` into ~/.config/containers/systemd/klaverjas-web.container.
# nginx: serves the frontend built into the image and proxies /ws and /api/ to
# klaverjas-server in the same pod. No volume, no secret, no state.
#   restart: systemctl --user restart klaverjas-web     logs: journalctl --user -u klaverjas-web
[Unit]
Description=Klaverjas web (nginx), https://@SITE@/

[Container]
Image=localhost/klaverjas-web:current
ContainerName=klaverjas-web
Pod=klaverjas.pod
Pull=never
ReadOnly=true
# Pid file and temp files; see deploy/nginx.conf.
Tmpfs=/tmp
Tmpfs=/var/cache/nginx
NoNewPrivileges=true
DropCapability=ALL
HealthCmd=wget -q -O /dev/null http://127.0.0.1:8080/
HealthInterval=60s
HealthRetries=3
# Three failed checks kill the container, and Restart= below brings it back.
HealthOnFailure=kill

[Service]
Restart=on-failure

[Install]
WantedBy=default.target
